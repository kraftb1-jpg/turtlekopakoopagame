<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bob-omb Battlefield Mountain Airport</title>
  <style>
    body { margin: 0; overflow: hidden; font-family: sans-serif; }
    #ui {
      position: absolute;
      top: 10px;
      left: 10px;
      color: #fff;
      background: rgba(0, 0, 0, 0.7);
      padding: 14px;
      border-radius: 8px;
      pointer-events: none;
    }
  </style>
</head>
<body>
  <div id="ui">
    <h3>Bob-omb Mountain Airport</h3>
    <p><b>WASD / Arrows:</b> Move / Fly</p>
    <p><b>Space:</b> Jump / Ascend Plane</p>
    <p><b>Shift:</b> Descend Plane</p>
    <p><b>E:</b> Board / Exit Plane (Near Plane)</p>
    <p id="status">Mode: Walking</p>
  </div>

  <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
        "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
      }
    }
  </script>

  <script type="module">
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';

    // --- Scene Setup ---
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x70c0ff);
    scene.fog = new THREE.FogExp2(0x70c0ff, 0.002);

    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.shadowMap.enabled = true;
    document.body.appendChild(renderer.domElement);

    const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
    scene.add(ambientLight);

    const dirLight = new THREE.DirectionalLight(0xffffff, 0.9);
    dirLight.position.set(100, 200, 80);
    dirLight.castShadow = true;
    scene.add(dirLight);

    const colliders = [];
    const planes = [];

    // --- Materials ---
    const grassMat = new THREE.MeshStandardMaterial({ color: 0x41b333, roughness: 0.8 });
    const cliffMat = new THREE.MeshStandardMaterial({ color: 0xb57032, roughness: 0.9 });
    const pathMat  = new THREE.MeshStandardMaterial({ color: 0xcc9c58, roughness: 0.9 });
    const rockMat  = new THREE.MeshStandardMaterial({ color: 0x888888, roughness: 0.7 });
    const woodMat  = new THREE.MeshStandardMaterial({ color: 0x8b5a2b, roughness: 0.8 });
    const fenceMat = new THREE.MeshStandardMaterial({ color: 0x333333, roughness: 0.5 });
    const padMat   = new THREE.MeshStandardMaterial({ color: 0xaaaaaa, roughness: 0.6 });

    // --- Recreating Bob-omb Battlefield Map ---
    function buildMap() {
      const mapGroup = new THREE.Group();

      // Outer Boundary Ring Hills
      const outerRingGeo = new THREE.RingGeometry(120, 220, 32);
      outerRingGeo.rotateX(-Math.PI / 2);
      const outerRing = new THREE.Mesh(
        new THREE.CylinderGeometry(200, 140, 60, 32, 1, true),
        grassMat
      );
      outerRing.position.y = 20;
      mapGroup.add(outerRing);

      // Main Ground Basin
      const mainGround = new THREE.Mesh(new THREE.CylinderGeometry(140, 140, 2, 32), grassMat);
      mainGround.position.y = -1;
      mapGroup.add(mainGround);
      colliders.push(mainGround);

      // --- Left Main Tiered Mountain (Airport Base) ---
      const mtnPos = { x: -35, z: -35 };

      // Tier 1 (Base)
      const t1Wall = new THREE.Mesh(new THREE.CylinderGeometry(45, 50, 16, 24), cliffMat);
      t1Wall.position.set(mtnPos.x, 8, mtnPos.z);
      mapGroup.add(t1Wall);
      const t1Top = new THREE.Mesh(new THREE.CylinderGeometry(45, 45, 1, 24), grassMat);
      t1Top.position.set(mtnPos.x, 16.5, mtnPos.z);
      mapGroup.add(t1Top);
      colliders.push(t1Top);

      // Tier 2 (Middle)
      const t2Wall = new THREE.Mesh(new THREE.CylinderGeometry(30, 35, 16, 24), cliffMat);
      t2Wall.position.set(mtnPos.x, 24, mtnPos.z);
      mapGroup.add(t2Wall);
      const t2Top = new THREE.Mesh(new THREE.CylinderGeometry(30, 30, 1, 24), grassMat);
      t2Top.position.set(mtnPos.x, 32.5, mtnPos.z);
      mapGroup.add(t2Top);
      colliders.push(t2Top);

      // Tier 3 (Summit Plateau - Airport Location)
      const t3Wall = new THREE.Mesh(new THREE.CylinderGeometry(18, 22, 14, 24), cliffMat);
      t3Wall.position.set(mtnPos.x, 39, mtnPos.z);
      mapGroup.add(t3Wall);
      const t3Top = new THREE.Mesh(new THREE.CylinderGeometry(18, 18, 1, 24), grassMat);
      t3Top.position.set(mtnPos.x, 46.5, mtnPos.z);
      mapGroup.add(t3Top);
      colliders.push(t3Top);

      // Winding Path Ramps around Mountain
      const ramp1 = new THREE.Mesh(new THREE.BoxGeometry(12, 1, 35), pathMat);
      ramp1.position.set(mtnPos.x + 32, 8, mtnPos.z + 10);
      ramp1.rotation.x = 0.35;
      ramp1.rotation.y = -0.2;
      mapGroup.add(ramp1);
      colliders.push(ramp1);

      const ramp2 = new THREE.Mesh(new THREE.BoxGeometry(10, 1, 28), pathMat);
      ramp2.position.set(mtnPos.x + 10, 24, mtnPos.z + 24);
      ramp2.rotation.z = -0.35;
      ramp2.rotation.y = 0.5;
      mapGroup.add(ramp2);
      colliders.push(ramp2);

      // Wooden Bridge Jutting out on Tier 2
      const bridge = new THREE.Mesh(new THREE.BoxGeometry(6, 0.8, 14), woodMat);
      bridge.position.set(mtnPos.x + 20, 33, mtnPos.z - 15);
      bridge.rotation.y = Math.PI / 4;
      mapGroup.add(bridge);
      colliders.push(bridge);

      // --- Gray Cave / Tunnel Mountain ---
      const caveMtn = new THREE.Mesh(new THREE.DodecahedronGeometry(22, 2), rockMat);
      caveMtn.position.set(mtnPos.x + 40, 12, mtnPos.z + 10);
      caveMtn.scale.set(1.2, 0.8, 1.2);
      mapGroup.add(caveMtn);
      colliders.push(caveMtn);

      // Tunnel Opening Frame
      const tunnelBox = new THREE.Mesh(new THREE.BoxGeometry(12, 10, 16), rockMat);
      tunnelBox.position.set(mtnPos.x + 22, 5, mtnPos.z + 10);
      mapGroup.add(tunnelBox);

      // Gate / Fence Structure
      const fence = new THREE.Mesh(new THREE.BoxGeometry(0.5, 8, 14), fenceMat);
      fence.position.set(mtnPos.x + 15, 6, mtnPos.z + 10);
      mapGroup.add(fence);

      // --- Right Elevated Curved Lawn & Fence ---
      const rightLawn = new THREE.Mesh(new THREE.CylinderGeometry(28, 32, 10, 20), cliffMat);
      rightLawn.position.set(35, 5, 10);
      mapGroup.add(rightLawn);
      const rightLawnTop = new THREE.Mesh(new THREE.CylinderGeometry(28, 28, 1, 20), grassMat);
      rightLawnTop.position.set(35, 10.5, 10);
      mapGroup.add(rightLawnTop);
      colliders.push(rightLawnTop);

      // Curved Dark Green Wall / Railing on Right Lawn
      const railing = new THREE.Mesh(new THREE.TorusGeometry(26, 0.8, 8, 24, Math.PI), fenceMat);
      railing.position.set(35, 12, 10);
      railing.rotation.x = Math.PI / 2;
      railing.rotation.z = -Math.PI / 4;
      mapGroup.add(railing);

      // --- Floating Island ---
      const floatIslandTop = new THREE.Mesh(new THREE.CylinderGeometry(12, 12, 1.5, 16), grassMat);
      floatIslandTop.position.set(45, 42, -20);
      mapGroup.add(floatIslandTop);
      colliders.push(floatIslandTop);

      const floatIslandBottom = new THREE.Mesh(new THREE.ConeGeometry(12, 12, 16), cliffMat);
      floatIslandBottom.position.set(45, 35, -20);
      floatIslandBottom.rotation.x = Math.PI;
      mapGroup.add(floatIslandBottom);

      // --- Dirt Paths & Stone Pads ---
      const pathRibbon = new THREE.Mesh(new THREE.PlaneGeometry(12, 110), pathMat);
      pathRibbon.rotation.x = -Math.PI / 2;
      pathRibbon.rotation.z = 0.4;
      pathRibbon.position.set(10, 0.1, 10);
      mapGroup.add(pathRibbon);

      // Stone Pads
      const pad1 = new THREE.Mesh(new THREE.CylinderGeometry(6, 6, 0.4, 16), padMat);
      pad1.position.set(-15, 0.2, 35);
      mapGroup.add(pad1);

      const pad2 = new THREE.Mesh(new THREE.CylinderGeometry(5, 5, 0.4, 16), padMat);
      pad2.position.set(25, 0.2, 55);
      mapGroup.add(pad2);

      // Ground Boulders
      const rock1 = new THREE.Mesh(new THREE.DodecahedronGeometry(3.5), rockMat);
      rock1.position.set(-10, 2, 20);
      mapGroup.add(rock1);
      colliders.push(rock1);

      const rock2 = new THREE.Mesh(new THREE.DodecahedronGeometry(4), rockMat);
      rock2.position.set(30, 2, -25);
      mapGroup.add(rock2);
      colliders.push(rock2);

      // --- Airport on Top Left Mountain Summit ---
      const runway = new THREE.Mesh(new THREE.BoxGeometry(16, 0.6, 28), fenceMat);
      runway.position.set(mtnPos.x, 47, mtnPos.z);
      mapGroup.add(runway);
      colliders.push(runway);

      scene.add(mapGroup);
      return mtnPos;
    }

    const mtnPos = buildMap();

    // --- Planes on Mountain Airport ---
    function createPlane(x, y, z) {
      const planeGroup = new THREE.Group();
      
      const body = new THREE.Mesh(
        new THREE.CylinderGeometry(0.8, 0.8, 6, 8),
        new THREE.MeshStandardMaterial({ color: 0xe74c3c })
      );
      body.rotation.x = Math.PI / 2;
      planeGroup.add(body);

      const wings = new THREE.Mesh(
        new THREE.BoxGeometry(10, 0.1, 1.8),
        new THREE.MeshStandardMaterial({ color: 0xf1c40f })
      );
      wings.position.set(0, 0.2, 0);
      planeGroup.add(wings);

      const tail = new THREE.Mesh(
        new THREE.BoxGeometry(0.1, 1.5, 1.2),
        new THREE.MeshStandardMaterial({ color: 0xe74c3c })
      );
      tail.position.set(0, 1, -2.4);
      planeGroup.add(tail);

      planeGroup.position.set(x, y, z);
      scene.add(planeGroup);
      planes.push(planeGroup);
    }

    // Spawn 2 Planes at the Left Mountain Airport Summit
    createPlane(mtnPos.x - 4, 48, mtnPos.z - 4);
    createPlane(mtnPos.x + 4, 48, mtnPos.z - 4);

    // --- Turtle Model Helper ---
    function createTurtleMesh() {
      const group = new THREE.Group();
      const shell = new THREE.Mesh(
        new THREE.SphereGeometry(1, 16, 16),
        new THREE.MeshStandardMaterial({ color: 0x27ae60 })
      );
      shell.scale.set(1, 0.5, 1.2);
      shell.position.y = 0.8;
      group.add(shell);

      const bodyMat = new THREE.MeshStandardMaterial({ color: 0xf1c40f });
      const head = new THREE.Mesh(new THREE.SphereGeometry(0.45, 12, 12), bodyMat);
      head.position.set(0, 0.9, 1.2);
      group.add(head);

      return group;
    }

    // Spawn Airport Worker Turtles around Mountain Summit
    for (let i = -8; i <= 8; i += 8) {
      const worker = createTurtleMesh();
      worker.position.set(mtnPos.x + i, 47, mtnPos.z + 8);
      worker.scale.set(1.2, 1.2, 1.2);
      scene.add(worker);
    }

    // --- Player System ---
    const playerMesh = new THREE.Group();
    const defaultAvatar = new THREE.Mesh(
      new THREE.CylinderGeometry(0.5, 0.5, 1.8),
      new THREE.MeshStandardMaterial({ color: 0x3498db })
    );
    defaultAvatar.position.y = 0.9;
    playerMesh.add(defaultAvatar);
    scene.add(playerMesh);

    const playerState = {
      isFlying: false,
      position: new THREE.Vector3(0, 2, 40), // Start near path
      velocity: new THREE.Vector3(),
      activePlane: null
    };

    function setTurtleAvatar(enable) {
      playerMesh.clear();
      if (enable) {
        const turtle = createTurtleMesh();
        turtle.scale.set(1.2, 1.2, 1.2);
        playerMesh.add(turtle);
      } else {
        playerMesh.add(defaultAvatar);
      }
    }

    // --- Controls ---
    const keys = {};
    window.addEventListener('keydown', (e) => {
      keys[e.code] = true;
      if (e.code === 'KeyE') togglePlane();
    });
    window.addEventListener('keyup', (e) => { keys[e.code] = false; });

    function togglePlane() {
      if (playerState.isFlying) {
        // Exit Plane
        playerState.isFlying = false;
        playerState.activePlane = null;
        setTurtleAvatar(false);
        playerState.position.y += 2;
        document.getElementById('status').innerText = "Mode: Walking";
      } else {
        // Board Plane
        planes.forEach((plane) => {
          if (playerState.position.distanceTo(plane.position) < 6) {
            playerState.isFlying = true;
            playerState.activePlane = plane;
            setTurtleAvatar(true); // Turtle pilot transformation
            document.getElementById('status').innerText = "Mode: Flying (Turtle Pilot)";
          }
        });
      }
    }

    // --- Physics & Game Loop ---
    const clock = new THREE.Clock();

    function update() {
      const delta = clock.getDelta();
      const speed = 15 * delta;
      const flySpeed = 35 * delta;

      if (playerState.isFlying && playerState.activePlane) {
        const plane = playerState.activePlane;
        if (keys['KeyW'] || keys['ArrowUp']) plane.translateZ(-flySpeed);
        if (keys['KeyS'] || keys['ArrowDown']) plane.translateZ(flySpeed * 0.5);
        if (keys['KeyA'] || keys['ArrowLeft']) plane.rotation.y += 1.8 * delta;
        if (keys['KeyD'] || keys['ArrowRight']) plane.rotation.y -= 1.8 * delta;
        if (keys['Space']) plane.position.y += flySpeed * 0.6;
        if (keys['ShiftLeft']) plane.position.y -= flySpeed * 0.6;

        playerState.position.copy(plane.position);
        playerMesh.position.copy(plane.position);
        playerMesh.rotation.copy(plane.rotation);
      } else {
        // Walking Controls
        const moveDir = new THREE.Vector3();
        if (keys['KeyW'] || keys['ArrowUp']) moveDir.z -= 1;
        if (keys['KeyS'] || keys['ArrowDown']) moveDir.z += 1;
        if (keys['KeyA'] || keys['ArrowLeft']) moveDir.x -= 1;
        if (keys['KeyD'] || keys['ArrowRight']) moveDir.x += 1;
        moveDir.normalize();

        playerState.velocity.y -= 30 * delta; // Gravity
        playerState.position.y += playerState.velocity.y * delta;

        playerState.position.x += moveDir.x * speed;
        playerState.position.z += moveDir.z * speed;

        // Ground Raycast Collision
        const raycaster = new THREE.Raycaster(
          playerState.position,
          new THREE.Vector3(0, -1, 0)
        );
        const hits = raycaster.intersectObjects(colliders);
        if (hits.length > 0 && hits[0].distance < 1.0) {
          playerState.position.y = hits[0].point.y + 1.0;
          playerState.velocity.y = 0;

          if (keys['Space']) {
            playerState.velocity.y = 12; // Jump
          }
        }

        playerMesh.position.copy(playerState.position);
      }

      // Camera Follow
      const camOffset = new THREE.Vector3(0, 6, 14);
      if (playerState.isFlying && playerState.activePlane) {
        camOffset.applyQuaternion(playerState.activePlane.quaternion);
        camera.position.copy(playerState.activePlane.position).add(camOffset);
        camera.lookAt(playerState.activePlane.position);
      } else {
        camera.position.copy(playerState.position).add(camOffset);
        camera.lookAt(playerState.position);
      }
    }

    function animate() {
      requestAnimationFrame(animate);
      update();
      renderer.render(scene, camera);
    }

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    animate();
  </script>
</body>
</html>
